generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Wedding {
  id                 String          @id @default(uuid())
  name               String
  date               DateTime?
  theme              String          @default("theme-linen-pure")
  ownerRole          String          @default("wedding_planner")
  brideName          String?
  groomName          String?
  plannerName        String?
  beneficiaries      String?
  baseBudget         Float           @default(0)
  onboardingComplete Boolean         @default(false)
  plannerAccessEnabled Boolean       @default(false)
  plannerDelegationMode String       @default("none")
  plannerCanSeePrivateThoughts Boolean @default(false)
  plannerCanSeeCoupleDirectMessages Boolean @default(false)
  vendorDelegationMode String        @default("couple")
  venueAddress       String?
  venueAccessTime    String?
  vendorInstructions String?
  invitationTitle     String?
  invitationMessage   String?
  invitationDetails   String?
  invitationDesignUrl String?
  invitationBackText  String?
  invitationStyle     String          @default("linen")
  rsvpConfirmedMessage String?
  rsvpDeclinedMessage  String?
  guests             Guest[]
  tables             Table[]
  agenda             AgendaItem[]
  messages           Message[]
  vendors            Vendor[]
  tracks             Track[]
  vendorPayments     VendorPayment[]
  budgetDocuments    BudgetDocument[]
  thoughts           WeddingThought[]
  accessProfiles     ProjectAccess[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt
}

model Guest {
  id        String   @id @default(uuid())
  name      String
  circle    String   @default("Friends")
  status    String   @default("Pending")
  agendaVis Boolean  @default(false)
  diet      Boolean  @default(false)
  groupName String?
  calendarGroup String?
  email     String?
  tableId   String?
  table     Table?   @relation(fields: [tableId], references: [id])
  weddingId String?
  wedding   Wedding? @relation(fields: [weddingId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Table {
  id        String   @id @default(uuid())
  name      String
  topPos    String   @default("top-20")
  leftPos   String   @default("left-20")
  sizeClass String   @default("w-32 h-32")
  chairs    Int      @default(4)
  guests    Guest[]
  weddingId String?
  wedding   Wedding? @relation(fields: [weddingId], references: [id])
}

model AgendaItem {
  id           String   @id @default(uuid())
  time         String
  title        String
  description  String
  isRestricted Boolean  @default(false)
  isDone       Boolean  @default(false)
  image        String?
  orderIndex   Int      @default(0)
  audience     String   @default("all")
  guestGroup   String?
  vendorRole   String?
  weddingId    String?
  wedding      Wedding? @relation(fields: [weddingId], references: [id])
}

model Message {
  id          String   @id @default(uuid())
  sender      String
  time        String
  text        String
  isImportant Boolean  @default(false)
  senderColor String   @default("primary")
  channel     String   @default("backstage")
  audience    String   @default("planner")
  vendorId    String?
  guestId     String?
  isPrivate   Boolean  @default(false)
  weddingId   String?
  wedding     Wedding? @relation(fields: [weddingId], references: [id])
  createdAt   DateTime @default(now())
}

model Vendor {
  id         String          @id @default(uuid())
  role       String
  name       String
  status     String          @default("Pending")
  budget     Float           @default(0)
  paid       Float           @default(0)
  phone      String?
  isCritical Boolean         @default(false)
  accessRole String?
  accessEnabled Boolean      @default(false)
  canMessageCouple Boolean   @default(false)
  canMessagePlanner Boolean  @default(true)
  canSeeGuestList Boolean    @default(false)
  canSeeFloorPlan Boolean    @default(false)
  canSeeMusicStudio Boolean  @default(false)
  missionNotes String?
  arrivalTime String?
  locationNotes String?
  contractStatus String       @default("non_recu")
  weddingId  String?
  wedding    Wedding?        @relation(fields: [weddingId], references: [id])
  payments   VendorPayment[]
  documents  BudgetDocument[]
}

model WeddingThought {
  id                 String   @id @default(uuid())
  title              String
  content            String?
  imageUrl           String?
  sharedWithPlanner  Boolean  @default(false)
  weddingId          String
  wedding            Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProjectAccess {
  id          String   @id @default(uuid())
  role        String
  displayName String?
  email       String?
  vendorId    String?
  guestId     String?
  permissions Json?
  isSuperUser Boolean  @default(false)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Track {
  id          String   @id @default(uuid())
  title       String
  artist      String
  orderIndex  Int      @default(0)
  directives  String?
  status      String   @default("queued") // queued, playing, played
  weddingId   String?
  wedding     Wedding? @relation(fields: [weddingId], references: [id])
  createdAt   DateTime @default(now())
}

model VendorPayment {
  id          String   @id @default(uuid())
  label       String
  amount      Float
  kind        String   @default("acompte")
  status      String   @default("paid")
  paidAt      DateTime @default(now())
  dueDate     DateTime?
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  documents   BudgetDocument[]
  createdAt   DateTime @default(now())
}

model BudgetDocument {
  id            String   @id @default(uuid())
  title         String
  type          String   @default("devis_propose")
  status        String   @default("active")
  amount        Float?
  documentUrl   String?
  fileName      String?
  notes         String?
  declinedReason String?
  isVerified    Boolean  @default(false)
  verifiedAt    DateTime?
  verifiedBy    String?
  requestedAt   DateTime?
  receivedAt    DateTime?
  paymentId     String?
  payment       VendorPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  vendorId      String?
  vendor        Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  weddingId     String
  wedding       Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
